{
  "name": "epower-knowledge-archive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p knowledge/tsconfig.json && vite build --config knowledge/vite.config.ts",
    "watch": "vite build --watch --config knowledge/vite.config.ts",
    "test": "node --test knowledge/tests/*.test.ts",
    "check": "tsc -p knowledge/tsconfig.json",
    "check:site": "node knowledge/scripts/check-site.mjs && node scripts/check-migration.mjs",
    "new": "node scripts/new-post.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/three": "0.183.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
